{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/ia/contact",
      "destination": "https://www.antonyaddy.com/contact?sujet=ia",
      "permanent": true
    },
    {
      "source": "/ia/en/contact",
      "destination": "https://www.antonyaddy.com/contact?sujet=ia",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "https://www.antonyaddy.com/contact?sujet=ia",
      "permanent": true
    },
    {
      "source": "/en/contact",
      "destination": "https://www.antonyaddy.com/contact?sujet=ia",
      "permanent": true
    },
    {
      "source": "/",
      "destination": "https://www.antonyaddy.com/ia",
      "permanent": true
    },
    {
      "source": "/:path((?!ia(?:/|$)|api/|_vercel/).+)",
      "destination": "https://www.antonyaddy.com/ia/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/ia/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/ia",
      "destination": "/ia/index.html"
    },
    {
      "source": "/ia/(.*)",
      "destination": "/ia/index.html"
    }
  ]
}
