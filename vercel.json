{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/ia/generateur-programme",
      "destination": "https://www.antonyaddy.com/ia/ressources",
      "permanent": true
    },
    {
      "source": "/ia/correction-email",
      "destination": "https://www.antonyaddy.com/ia/ressources",
      "permanent": true
    },
    {
      "source": "/ia/en/generateur-programme",
      "destination": "https://www.antonyaddy.com/ia/en/ressources",
      "permanent": true
    },
    {
      "source": "/ia/en/correction-email",
      "destination": "https://www.antonyaddy.com/ia/en/ressources",
      "permanent": true
    },
    {
      "source": "/ia/contact",
      "destination": "https://www.antonyaddy.com/contact?sujet=ia",
      "permanent": true
    },
    {
      "source": "/ia/en/contact",
      "destination": "https://www.antonyaddy.com/contact?sujet=ia",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "https://www.antonyaddy.com/contact?sujet=ia",
      "permanent": true
    },
    {
      "source": "/en/contact",
      "destination": "https://www.antonyaddy.com/contact?sujet=ia",
      "permanent": true
    },
    {
      "source": "/",
      "destination": "https://www.antonyaddy.com/ia",
      "permanent": true
    },
    {
      "source": "/:path((?!ia(?:/|$)|_vercel/).+)",
      "destination": "https://www.antonyaddy.com/ia/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/ia",
      "destination": "/ia/index.html"
    },
    {
      "source": "/ia/(.*)",
      "destination": "/ia/index.html"
    }
  ],
  "headers": [
    {
      "source": "/ia/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
